<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================================================================== -->
    <!-- PARENT SPRING BOOT: Hereda configuraciones y versiones estables del framework -->
    <!-- ============================================================================== -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.3</version>
        <relativePath/>
    </parent>

    <groupId>com.techstore</groupId>
    <artifactId>sistema-tecnologia-stock</artifactId>
    <version>1.0.0</version>
    <name>sistema-tecnologia-stock</name>
    <description>Sistema de Gestion de Stock y Compras para Productos de Tecnologia con MVC y Thymeleaf</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- ========================================================================= -->
        <!-- CAPA WEB Y ARQUITECTURA MVC (Spring MVC)                                  -->
        <!-- Habilita @Controller, enrutamiento HTTP, manejo de sesiones y Tomcat      -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ========================================================================= -->
        <!-- MOTOR DE PLANTILLAS PARA LA VISTA (Thymeleaf)                            -->
        <!-- Permite renderizar HTML dinámico comunicándose con el Model de Spring MVC -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ========================================================================= -->
        <!-- CAPA DE PERSISTENCIA / ORM (Spring Data JPA + Hibernate)                 -->
        <!-- Mapea clases @Entity a tablas SQL y provee operaciones CRUD automáticas   -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ========================================================================= -->
        <!-- CONECTOR JDBC OFICIAL DE MYSQL                                            -->
        <!-- Driver de comunicación por red con la base de datos MySQL local o remota  -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================================================================= -->
        <!-- VALIDACIONES DE FORMULARIOS Y DTOS (Jakarta Validation API)               -->
        <!-- Anotaciones @NotBlank, @Min, @NotNull, @Size para validar datos entrantes -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ========================================================================= -->
        <!-- LOMBOK (Reducción de código repetitivo)                                   -->
        <!-- Genera Getters, Setters, Constructores y Builders automáticamente         -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ========================================================================= -->
        <!-- TESTING                                                                   -->
        <!-- ========================================================================= -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin para empaquetar la aplicación como un ejecutable JAR autocontenido -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>